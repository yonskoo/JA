-- Filesystem helpers
local function hasFS()
    return pcall(function()
        assert(type(writefile)=="function" and type(readfile)=="function" and type(isfile)=="function")
    end)
end
local function saveKey(fn,k)  if hasFS() then pcall(writefile,fn..".txt",k) end end
local function loadKey(fn)
    if not hasFS() then return nil end
    local ok,v = pcall(readfile,fn..".txt")
    return ok and type(v)=="string" and v~="" and v or nil
end
local function clearKey(fn)
    if not hasFS() then return end
    pcall(function()
        if type(delfile)=="function" then delfile(fn..".txt") else writefile(fn..".txt","") end
    end)
end

-- General helpers
local function safeParent(gui, target)
    if syn and syn.protect_gui then pcall(syn.protect_gui,gui)
    elseif type(protect_gui)=="function" then pcall(protect_gui,gui) end
    local ok = pcall(function() gui.Parent = target end)
    if not ok then
        pcall(function()
            local lp = Players.LocalPlayer
            if lp and lp:FindFirstChild("PlayerGui") then gui.Parent = lp.PlayerGui end
        end)
    end
end

local function make(cls,props,parent)
    local o = Instance.new(cls)
    for k,v in pairs(props) do o[k]=v end
    if parent then o.Parent=parent end
    return o
end
local function corner(r,p)     local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(0,r); c.Parent=p end
local function stroke(col,th,tr,p) local s=Instance.new("UIStroke"); s.Color=col; s.Thickness=th; s.Transparency=tr; s.Parent=p; return s end
local function tw(o,t,props,style) TweenService:Create(o,TweenInfo.new(t,style or Enum.EasingStyle.Quad),props):Play() end
local function imgLabel(icon,sz,col,parent)
    return make("ImageLabel",{Size=UDim2.new(0,sz,0,sz),BackgroundTransparency=1,
        Image=icon,ImageColor3=col or Color3.new(1,1,1),ScaleType=Enum.ScaleType.Fit},parent)
end
local function clipboard(txt) if type(setclipboard)=="function" then pcall(setclipboard,txt) end end

local function getExecutor()
    local name="Unknown"
    pcall(function()
        if identifyexecutor then name=identifyexecutor()
        elseif getexecutorname then name=getexecutorname()
        elseif type(syn)=="table" then name="Synapse X"
        elseif KRNL_LOADED then name="KRNL"
        elseif fluxus then name="Fluxus"
        end
    end)
    return name
end

local function getDevice()
    local s,r=pcall(function()
        return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled and "Mobile"
            or UserInputService.TouchEnabled and UserInputService.KeyboardEnabled and "Tablet"
            or "Desktop"
    end)
    return s and r or "Unknown"
end

local function checkKey(k)
    local lp = Players.LocalPlayer
    local savedKick, savedShutdown, hooked = nil, nil, false

    pcall(function()
        if type(hookfunction) == "function" then
            savedKick = hookfunction(lp.Kick, newcclosure(function() end))
            hooked = true
        end
    end)
    pcall(function()
        if type(hookfunction) == "function" and type(game.Shutdown) == "function" then
            savedShutdown = hookfunction(game.Shutdown, newcclosure(function() end))
        end
    end)

    local oldNamecall, ncHooked = nil, false
    if not hooked then
        pcall(function()
            if type(hookmetamethod) == "function" then
                oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                    local method = getnamecallmethod()
                    if method == "Kick" or method == "Shutdown" then
                        return nil
                    end
                    return oldNamecall(self, ...)
                end))
                ncHooked = true
            end
        end)
    end

    local ok, result = pcall(function() return Junkie.check_key(k) end)

    -- Restore everything
    pcall(function() if savedKick then hookfunction(lp.Kick, savedKick) end end)
    pcall(function() if savedShutdown then hookfunction(game.Shutdown, savedShutdown) end end)
    pcall(function() if ncHooked and oldNamecall then hookmetamethod(game, "__namecall", oldNamecall) end end)

    if not ok then return { valid=false, error="SDK error", message=tostring(result) } end
    return result or { valid=false, error="No response", message="No response" }
end

-- Loading screen
local _loaderActive = nil

local function spawnLoaderParticle(parent, mobile, tweenF)
    local A  = Color3.fromRGB(60,  120, 255)
    local A2 = Color3.fromRGB(100, 160, 255)
    local sz = math.random(3, mobile and 6 or 9)
    local xp = math.random(0, 100) / 100
    local dur= math.random(55, 110) / 10

    local shard = make("Frame",{
        Size=UDim2.fromOffset(sz,sz*1.8),
        AnchorPoint=Vector2.new(.5,.5),
        Position=UDim2.new(xp,0, 0, math.ceil(sz)),
        BackgroundColor3 = math.random()>.5 and A or A2,
        BackgroundTransparency = math.random(35,60)/100,
        BorderSizePixel=0,
        Rotation=math.random(0,360),
        ZIndex=1,
    },parent)
    corner(100,shard)

    local endX = math.clamp(xp + math.random(-10,10)/100, .02, .98)
    TweenService:Create(shard, tweenF(dur, Enum.EasingStyle.Linear), {
        Position=UDim2.new(endX,0,1,math.ceil(sz)),
        Rotation=shard.Rotation + math.random(80,220),
        BackgroundTransparency=1,
    }):Play()
    task.delay(dur, function() if shard.Parent then shard:Destroy() end end)
end

local function showJALoader(options)
    options = options or {}
    local title      = options.Title    or "Loading JA"
    local phases     = options.Phases   or {"Initializing","Checking access","Loading interface","Ready"}
    local speed      = math.clamp(tonumber(options.Speed) or 1, .1, 8)
    local onComplete = options.OnComplete
    local mobile     = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
   

    -- colour constants matching JA palette
    local A   = Color3.fromRGB(60,  120, 255)
    local A2  = Color3.fromRGB(100, 160, 255)
    local BG  = Color3.fromRGB(10,   8,  18)
    local TX  = Color3.fromRGB(235, 230, 255)
    local DM  = Color3.fromRGB(130, 120, 170)
    local SC  = Color3.fromRGB(50,  200, 130)

    local function waitFor(t) task.wait(t/speed) end
    local function tweenF(t,es,ed)
        return TweenInfo.new(t/speed, es or Enum.EasingStyle.Quad, ed or Enum.EasingDirection.Out)
    end

    if _loaderActive then pcall(function() _loaderActive:Destroy() end) end

    local gui = make("ScreenGui",{Name="JA_Loader",ResetOnSpawn=false,
        ZIndexBehavior=Enum.ZIndexBehavior.Sibling,IgnoreGuiInset=true,DisplayOrder=1000})
    safeParent(gui, game:GetService("CoreGui"))
    _loaderActive = gui

    local blur = make("BlurEffect",{Name="JA_LoaderBlur",Size=0},Lighting)
    gui.Destroying:Connect(function() if blur.Parent then blur:Destroy() end end)

    -- full-screen overlay
    local overlay = make("Frame",{Size=UDim2.fromScale(1,1),
        BackgroundColor3=BG, BackgroundTransparency=1, BorderSizePixel=0},gui)

    -- particle layer
    local pLayer = make("Frame",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,
        ZIndex=0, ClipsDescendants=true},overlay)
    task.spawn(function()
        while pLayer.Parent do
            spawnLoaderParticle(pLayer, mobile, tweenF)
            waitFor(0.5)
        end
    end)

    local iconSize = mobile and 80 or 110
    local iconImg = imgLabel(I.Shield, iconSize, A, overlay)
    iconImg.AnchorPoint = Vector2.new(.5,.5)
    iconImg.Position    = UDim2.new(.5,0,.42,0)
    iconImg.ZIndex      = 4
    iconImg.ImageTransparency = 0.95

    local iconScale = Instance.new("UIScale"); iconScale.Scale=0.1; iconScale.Parent=iconImg
    local stageSize = mobile and 120 or 150

    -- title label
    make("TextLabel",{
        Size=UDim2.fromOffset(mobile and 200 or 260,28),
        AnchorPoint=Vector2.new(.5,0),
        Position=UDim2.new(.5,0,.42, math.ceil(stageSize*.5)+14),
        BackgroundTransparency=1,
        Text=title,
        TextColor3=TX,
        Font=Enum.Font.GothamBold,
        TextSize=mobile and 16 or 20,
        TextXAlignment=Enum.TextXAlignment.Center,
        TextTransparency=1,
    },overlay)

    -- phase label
    local phaseLabel = make("TextLabel",{
        Size=UDim2.fromOffset(mobile and 220 or 280,22),
        AnchorPoint=Vector2.new(.5,0),
        Position=UDim2.new(.5,0,.42, math.ceil(stageSize*.5)+46),
        BackgroundTransparency=1,
        Text="",
        TextColor3=DM,
        Font=Enum.Font.GothamSemibold,
        TextSize=mobile and 12 or 13,
        TextXAlignment=Enum.TextXAlignment.Center,
        TextTransparency=1,
    },overlay)

    -- progress bar
    local barW = mobile and 200 or 260
    local barBg = make("Frame",{
        Size=UDim2.fromOffset(barW,4),
        AnchorPoint=Vector2.new(.5,0),
        Position=UDim2.new(.5,0,.42, math.ceil(stageSize*.5)+76),
        BackgroundColor3=Color3.fromRGB(20,16,38),BorderSizePixel=0,ZIndex=2},overlay)
    corner(2,barBg)
    local barFill = make("Frame",{Size=UDim2.new(0,0,1,0),
        BackgroundColor3=A,BorderSizePixel=0,ZIndex=3},barBg)
    corner(2,barFill)
    local bfg=Instance.new("UIGradient")
    bfg.Color=ColorSequence.new{ColorSequenceKeypoint.new(0,A2),ColorSequenceKeypoint.new(1,A)}
    bfg.Parent=barFill

    local done = false

    local function showPhase(txt)
        TweenService:Create(phaseLabel,tweenF(.12),{TextTransparency=1}):Play()
        waitFor(.14)
        phaseLabel.Text = txt
        TweenService:Create(phaseLabel,tweenF(.2),{TextTransparency=0,TextColor3=DM}):Play()
    end

    local function setBar(pct)
        TweenService:Create(barFill,tweenF(.3),{Size=UDim2.new(pct,0,1,0)}):Play()
    end

    local function finishFade(cb)
        TweenService:Create(iconImg, tweenF(.4,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{ImageTransparency=1}):Play()
        TweenService:Create(iconScale,tweenF(.4,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Scale=.5}):Play()
        TweenService:Create(phaseLabel,tweenF(.3),{TextTransparency=1}):Play()
        waitFor(.44)

        TweenService:Create(overlay,tweenF(.4),{BackgroundTransparency=1}):Play()
        TweenService:Create(blur,tweenF(.35),{Size=0}):Play()
        waitFor(.42)
        done=true
        pcall(function() gui:Destroy() end)
        if cb then pcall(cb) end
    end

    -- animate 
    task.spawn(function()
        TweenService:Create(blur,tweenF(.5),{Size=18}):Play()
        TweenService:Create(overlay,tweenF(.4),{BackgroundTransparency=.15}):Play()
        for _,lbl in ipairs(overlay:GetChildren()) do
            if lbl:IsA("TextLabel") and lbl.Text==title then
                TweenService:Create(lbl,tweenF(.4),{TextTransparency=0}):Play()
            end
        end
        waitFor(.5)

        local scaleSteps = {.28,.5,.68,.86,1}
        local alphaSteps = {.72,.5,.32,.14,0}
        local nPhases    = #phases

        for idx,phase in ipairs(phases) do
            if done then return end
            showPhase(phase)
            local prog = idx/nPhases
            setBar(prog)
            local si = math.min(idx,5)
            TweenService:Create(iconScale,tweenF(.5,Enum.EasingStyle.Back),{Scale=scaleSteps[si]}):Play()
            TweenService:Create(iconImg,tweenF(.5),{ImageTransparency=alphaSteps[si]}):Play()
            waitFor(.75)
        end

        setBar(1)
        TweenService:Create(iconScale,tweenF(.2,Enum.EasingStyle.Sine),{Scale=1.1}):Play()
        TweenService:Create(phaseLabel,tweenF(.25),{TextColor3=SC}):Play()
        phaseLabel.Text = "Ready"
        waitFor(.2)
        TweenService:Create(iconScale,tweenF(.15),{Scale=1}):Play()
        waitFor(.5)
        finishFade(onComplete)
    end)

    while not done do task.wait(.05) end
end

-- Notification
local function Notify(title, desc, kind, duration)
    duration = duration or 3
    local SC = Color3.fromRGB(50,200,130)
    local ER = Color3.fromRGB(255,75,90)
    local A  = Color3.fromRGB(60,120,255)
    local TX = Color3.fromRGB(235,230,255)
    local col = kind=="success" and SC or kind=="error" and ER or A
    local ico = kind=="success" and I.CheckCircle or kind=="error" and I.XCircle or kind=="loading" and I.Spinner or I.Info

    local ng = make("ScreenGui",{Name="JA_Notif",ResetOnSpawn=false,
        ZIndexBehavior=Enum.ZIndexBehavior.Sibling,IgnoreGuiInset=true})
    safeParent(ng, game:GetService("CoreGui"))

    local nf = make("Frame",{Size=UDim2.new(0,0,0,50),Position=UDim2.new(1,20,1,-20),
        AnchorPoint=Vector2.new(1,1),BackgroundColor3=Color3.fromRGB(10,8,20),BorderSizePixel=0,ZIndex=9999},ng)
    corner(12,nf); stroke(col,1.5,0,nf)
    local ngg=Instance.new("UIGradient")
    ngg.Color=ColorSequence.new{ColorSequenceKeypoint.new(0,Color3.fromRGB(14,12,30)),ColorSequenceKeypoint.new(1,Color3.fromRGB(8,6,18))}
    ngg.Rotation=135; ngg.Parent=nf
    local ci=imgLabel(ico,20,col,nf); ci.AnchorPoint=Vector2.new(0,.5); ci.Position=UDim2.new(0,12,.5,0); ci.ZIndex=10000
    if kind=="loading" then
        TweenService:Create(ci,TweenInfo.new(1,Enum.EasingStyle.Linear,Enum.EasingDirection.InOut,-1),{Rotation=360}):Play()
    end
    make("TextLabel",{Size=UDim2.new(0,210,0,22),Position=UDim2.new(0,38,0,6),BackgroundTransparency=1,
        Text=title,TextColor3=TX,Font=Enum.Font.GothamBold,TextSize=14,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=10000},nf)
    make("TextLabel",{Size=UDim2.new(0,210,0,12),Position=UDim2.new(0,38,0,30),BackgroundTransparency=1,
        Text=desc,TextColor3=col,Font=Enum.Font.Gotham,TextSize=11,
        TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,ZIndex=10000},nf)
    TweenService:Create(nf,TweenInfo.new(.4,Enum.EasingStyle.Back,Enum.EasingDirection.Out),
        {Size=UDim2.new(0,260,0,50),Position=UDim2.new(1,-20,1,-20)}):Play()

    local function dismiss()
        if nf and nf.Parent then
            tw(nf,.3,{Position=UDim2.new(1,20,1,-20),BackgroundTransparency=1})
            task.wait(.35); pcall(function() ng:Destroy() end)
        end
    end
    if duration>0 then task.delay(duration, dismiss) end
    return dismiss
end

