-- Launch
function JA:Launch(cfg)
    cfg=cfg or {}
    if getgenv then getgenv().JA_KEY=nil; getgenv().JA_CLOSED=false; getgenv().UI_CLOSED=false end

    -- Step 1: show the JA loading screen
    showJALoader({
        Title  = "JA",
        Phases = {"Initializing","Loading","Ready"},
        Speed  = 3,
        OnComplete = function()
            task.spawn(function()
                local saved = loadKey(self.FileName)
                if saved then
                    local dismiss = Notify("Verifying Key","Checking saved key...","loading",0)
                    local ok, result = pcall(function() return checkKey(saved) end)
                    if type(dismiss)=="function" then pcall(dismiss) end
                    if ok and type(result)=="table" and result.valid then
                        if getgenv then
                            getgenv().SCRIPT_KEY = saved
                            getgenv().JA_KEY     = saved
                            getgenv().JA_CLOSED  = true
                        end
                        Notify("✓  Script Executed",self.Title.." loaded successfully","success",4)
                        loadstring(game:HttpGet(MAIN_SCRIPT))()
                        return
                    end
                    clearKey(self.FileName)
                    Notify("Invalid Key","Saved key is invalid. Please enter a new key.","error",4)
                end
                if getgenv then getgenv().UI_CLOSED=false end
                buildUI(self,cfg)
            end)
        end,
    })

    while not(getgenv and (getgenv().JA_CLOSED or getgenv().UI_CLOSED)) do task.wait(.1) end
    return getgenv and getgenv().JA_KEY or nil
end

return JA
